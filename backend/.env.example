APP_NAME="Loon Interior"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://yourdomain.com

LOG_CHANNEL=single
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=cpaneluser_interior
DB_USERNAME=cpaneluser_dbuser
DB_PASSWORD=

SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# Visit https://yourdomain.com/install/<INSTALL_KEY> once to run migrations + seed
# (useful when cPanel has no Terminal). Leave empty afterwards to disable.
INSTALL_KEY=

# First admin account (created by the seeder)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe@123
